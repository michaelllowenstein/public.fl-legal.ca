{
  "compilerOptions": {
    "target":           "ES2020",
    "module":           "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop":  true,
    "strict":           false,
    "skipLibCheck":     true,
    "rootDir":          "../",
    "paths": {
      "@config":        ["../server/src/config/index"],
      "@schema":        ["../server/src/schema/index"],
      "@schema/*":      ["../server/src/schema/*"],
      "@services/*":    ["../server/src/services/*"],
      "@plugins/*":     ["../server/src/plugins/*"],
      "@routes/*":      ["../server/src/routes/*"]
    },
    "outDir": "./api/dist"
  },
  "include": [
    "../api/*.ts",
    "../server/src/**/*.ts"
  ],
  "exclude": [
    "../api/dist",
  ]
}