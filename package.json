{
  "name": "fl-legal.ca",
  "private": true,
  "scripts": {
    "build:app": "cd client && npm ci --legacy-peer-deps && npm run build -- --configuration production",
    "build:client": "cd client && npm run build -- --configuration production",
    "install:prod": "npm ci --legacy-peer-deps",
    "local": "concurrently --names \"API,NG\" --prefix-colors \"cyan,magenta\" \"npm run local:api\" \"npm run local:app\"",
    "local:api": "cd server && npm run local",
    "local:app": "cd client && ng serve --configuration local --port 4422 --proxy-config proxy.conf.json",
    "test": "npm run test:server && npm run test:client",
    "test:server": "cd server && npm test",
    "test:client": "node --import tsx --test --experimental-test-coverage \"client/test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/compression": "^1.8.1",
    "@types/dotenv": "^6.1.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/nodemailer-sendgrid": "^1.0.3",
    "concurrently": "^8.2.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@vercel/node": "^5.7.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.2",
    "compression": "^1.8.1",
    "dotenv": "^17.4.1",
    "fastify": "^5.8.4",
    "fastify-plugin": "^5.1.0",
    "firebase-admin": "^13.7.0",
    "https": "^1.0.0",
    "nodemailer": "^8.0.3",
    "nodemailer-sendgrid": "^1.0.3",
    "pino-pretty": "^13.1.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsconfig-paths": "^4.2.0"
  }
}
