{
  "version": 2,
  "buildCommand": "cd client && npm ci --legacy-peer-deps && npm run build -- --configuration production",
  "outputDirectory": "client/dist/fl-legal.ca/browser",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 15
    }
  }
}
