{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "daf1539f-8125-4ecc-a907-7920f27b668a"
  },
  "newProjectRoot": "projects",
  "projects": {
    "fl-legal.ca": {
      "projectType": "application",
      "schematics": {
        "@appschematics/angular:component": {
          "style": "scss",
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "allowedCommonJsDependencies": ["html2pdf.js"],
            "externalDependencies": ["firebase-admin"],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              "src/favicon.ico",
              "src/assets",
              "src/sitemap.xml",
              "src/robots.txt"
            ],
            "styles": [
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/envs/env.ts",
                  "with": "src/envs/env.prod.ts"
                }
              ],
              "optimization": true,
              "extractLicenses": true,
              "sourceMap": {
                "hidden": false,
                "scripts": true,
                "styles": false
              },
              "namedChunks": true,
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "local": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "defaultConfiguration": {
              "fileReplacements": [
                {
                  "replace": "src/envs/env.ts",
                  "with": "src/envs/env.prod.ts"
                }
              ],
              "optimization": true,
              "extractLicenses": true,
              "sourceMap": {
                "hidden": false,
                "scripts": true,
                "styles": false
              },
              "namedChunks": true,
              "outputHashing": "all"
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "fl-legal.ca:build:production"
            },
            "development": {
              "buildTarget": "fl-legal.ca:build:development"
            },
            "local": {
              "buildTarget": "fl-legal.ca:build:local",
              "ssl": true,
              "sslCert": "cert/local/localhost.crt",
              "sslKey":  "cert/local/localhost.decrypted.key",
              "proxyConfig": "proxy.conf.json"
            }
          },
          "defaultConfiguration": "local"
        }
      }
    }
  }
}
